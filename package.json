{
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter summon-team dev",
    "test": "pnpm test:scripts && pnpm -r --if-present test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:canon": "node scripts/check-canon.mjs",
    "check:css": "node scripts/check-css-contrast-motion.mjs",
    "check:doctor": "node packages/summon-team/dist/index.js doctor",
    "harvest:debt": "node scripts/harvest-debt.mjs",
    "team:compose": "node scripts/compose-team.mjs --party summon-core --out build/team",
    "team:skills": "node scripts/compose-team.mjs --party summon-core --harness skills --out build/skills",
    "team:watch": "node scripts/team-log.mjs render --log .summon/team-log.jsonl --skin jrpg-16bit",
    "team:dissent": "node scripts/team-log.mjs dissent --log .summon/team-log.jsonl --last 10",
    "team:control": "node scripts/team-log.mjs control --log .summon/team-log.jsonl --item negative-control --lenses simplicity,test-quality,security,conformance",
    "team:checks": "node scripts/run-checks.mjs --party summon-core"
  }
}
